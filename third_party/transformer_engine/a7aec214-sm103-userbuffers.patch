 #include "../extensions.h"
+#include <climits>
+#include "../../../common/comm_gemm_overlap/userbuffers/userbuffers.h"
 #include "transformer_engine/transformer_engine.h"
 
 #define HALF_BYTES 2
@@ -509,4 +511,43 @@ void transformer_engine::pytorch::bulk_overlap_ag_with_external_gemm(
   auto main_stream = at::cuda::getCurrentCUDAStream();
   allgather_communicator.bulk_overlap_external_ag(at::cuda::CUDAStream(send_stream),
                                                   at::cuda::CUDAStream(recv_stream), main_stream);
+}
+
+void CommOverlapP2P::configure_userbuffers_p2p(int sms, bool use_ce, bool push) {
+  NVTE_CHECK(!_with_cublasmp && _ub_comm != nullptr, "fuse adapter requires native Userbuffers");
+  NVTE_CHECK(sms > 0 && sms <= UB_MAX_SM, "invalid communication SM budget");
+  _ub_comm->sms = sms;
+  _ub_comm->use_ce = use_ce;
+  _ub_comm->push = push;
 }
+
+void CommOverlapP2P::validate_fuse_p2p(int64_t src, int64_t dst, int64_t bytes, int peer) {
+  const int64_t capacity = _ubuf.numel() * _ubuf.element_size();
+  NVTE_CHECK(!_with_cublasmp && _ub_comm != nullptr, "native UB communicator required");
+  NVTE_CHECK(peer >= 0 && peer < _tp_size && peer != _tp_id, "invalid P2P peer");
+  NVTE_CHECK(src >= 0 && dst >= 0 && bytes > 0 && bytes <= capacity &&
+             src <= capacity - bytes && dst <= capacity - bytes,
+             "P2P range exceeds registered Userbuffer");
+  NVTE_CHECK(src % 16 == 0 && dst % 16 == 0 && bytes % 16 == 0,
+             "Userbuffers P2P requires 16-byte alignment");
+  NVTE_CHECK(bytes / 16 <= INT_MAX, "P2P range exceeds underlying kernel indexing");
+}
+
+at::Stream CommOverlapP2P::get_userbuffers_send_stream(int index) {
+  NVTE_CHECK(index >= 0 && index < _stream_send.size(), "invalid send stream index");
+  return at::cuda::getStreamFromExternal(_stream_send[index], at::cuda::current_device());
+}
+
+void CommOverlapP2P::userbuffers_p2p_send(int64_t src, int64_t dst, int64_t bytes,
+                                        int peer, int stream) {
+  validate_fuse_p2p(src, dst, bytes, peer);
+  NVTE_CHECK(stream >= 0 && stream < _stream_send.size(), "invalid send stream index");
+  userbuffers_send(_ub_reg, src, _ub_reg, dst, bytes, _ub_comm,
+                   _rank - _tp_id + peer, _stream_send[stream]);
+}
+
+void CommOverlapP2P::userbuffers_p2p_recv(int64_t src, int64_t dst, int64_t bytes, int peer) {
+  validate_fuse_p2p(src, dst, bytes, peer);
+  userbuffers_recv(_ub_reg, src, _ub_reg, dst, bytes, _ub_comm,
+                   _rank - _tp_id + peer, _stream_recv);
+}
